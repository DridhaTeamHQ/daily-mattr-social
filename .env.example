# ── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser, never import outside lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Used to adjudicate Instagram screenshots. If unset, every submission that
# passes the deterministic checks lands in the manual review queue instead —
# the app still works, it just stops auto-approving.
OPENAI_API_KEY=
# Vision adjudication. Leave unset unless you have a reason — the default is
# gpt-4.1-mini, and the cheaper gpt-4o-mini cannot read an 11px handle.
# OPENAI_VISION_MODEL=gpt-4.1-mini

# ── App ─────────────────────────────────────────────────────────────────────
# Public origin, used to build ambassador survey links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public app download URL included in ambassador welcome emails.
NEXT_PUBLIC_APP_DOWNLOAD_URL=

# Salt for hashing survey respondent IPs. Change this and existing duplicate
# detection resets. Generate with: openssl rand -hex 32
IP_HASH_SALT=change-me-to-a-long-random-string

# ── Seed ────────────────────────────────────────────────────────────────────
# Password given to the demo accounts created by `npm run seed`. Leave unset
# and the script generates a random one and prints it.
SEED_PASSWORD=

# ── Web Push ────────────────────────────────────────────────────────────────
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these, push is disabled and the app falls back to in-app notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email delivery for ambassador welcome emails via Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=onboarding@example.com
BREVO_SENDER_NAME=DailyMattr

# Optional Upstash Redis cache. Failure or missing keys falls back to Supabase.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REDIS_CACHE_ENABLED=false
# Full Redis request deadline (100–3000 ms; default 800).
# REDIS_CACHE_TIMEOUT_MS=800
# Default isolates Supabase project + development/preview/production.
# Override only with a unique prefix for this project/environment.
# REDIS_CACHE_PREFIX=dailymattr:my-project:production:v1
